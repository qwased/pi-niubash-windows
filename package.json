{
  "name": "pi-niubash-windows",
  "version": "0.1.1",
  "description": "Niubash (native Windows bash) as a Pi tool, coexisting with Pi's PowerShell tool.",
  "license": "MIT",
  "author": "qwased",
  "homepage": "https://github.com/qwased/pi-niubash-windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwased/pi-niubash-windows.git"
  },
  "bugs": {
    "url": "https://github.com/qwased/pi-niubash-windows/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "niubash",
    "bash",
    "windows",
    "shell"
  ],
  "files": [
    "src",
    "skill",
    "docs/DESIGN.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/niubash.ts"
    ],
    "skills": [
      "./skill"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json"
  }
}
